<script>
function sendPersonvernSMS(mobil, navn, message) {
    if (!mobil) {
        alert('Mangler mobilnummer.');
        return;
    }
    jQuery('#personvern-sms-recipients').val('[' + mobil + ', ' + navn + ']');
    jQuery('#personvern-sms-message').val(message);
    jQuery('#personvern-sms-form').submit();
}
</script>

<form action="?page=UKMSMS_gui" method="POST" id="personvern-sms-form" style="display:none;">
    <input type="hidden" name="UKMSMS_message" id="personvern-sms-message" />
    <input type="hidden" name="UKMSMS_recipients" id="personvern-sms-recipients" />
</form>

{% macro personvern_tabell(personer, under18, delta_base_url, personvern_prosjekt_id) %}
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Mobil</th>
                <th>Foresatt Navn</th>
                <th>Foresatt Mobil</th>
                <th>Samtykke Skjema</th>
                <th>Svar</th>
                <th>Foresatt Samtykke</th>
                <th>Send SMS</th>
            </tr>
        </thead>
        <tbody>
            {% for person in personer %}
                {% set deltakerNavn = person.person.getNavn() %}
                {% set deltakerMobil = person.person.getMobil() %}
                {% set foresattNavn = person.deltaRespondent ? person.deltaRespondent.getForesattNavn() : null %}
                {% set foresattMobil = person.deltaRespondent ? person.deltaRespondent.getForesattMobil() : null %}
                {% set deltaUserId = person.deltaRespondent ? person.deltaRespondent.getId() : null %}
                {% set harSvar = person.svar and person.svar.erSamtykkeGitt() %}
                {% set harForesattSamtykke = person.foresattSamtykke %}
                {% set erKomplett = under18 ? (harSvar and harForesattSamtykke) : harSvar %}
                {% set deltakerLenke = delta_base_url ~ '/ukmid/samtykkeskjema/' ~ personvern_prosjekt_id ~ '/' %}
                {% set foresattLenke = deltaUserId ? delta_base_url ~ '/ukmid/samtykkeskjema/' ~ personvern_prosjekt_id ~ '/' ~ deltaUserId ~ '/' : '' %}
                {% set meldingDeltaker = 'Hei! Du er påmeldt UKM. Les om personvern og ta stilling her: ' ~ deltakerLenke ~ ' Hilsen UKM Norge' %}
                {% set meldingForesatt = 'Hei! Du er oppgitt som foresatt for ' ~ deltakerNavn ~ ' som er påmeldt UKM. Les om personvern og gi ditt samtykke her: ' ~ foresattLenke ~ ' Hilsen UKM Norge' %}
                <tr class="table-personvern {{ erKomplett ? 'success' : '' }}">
                    <td>{{ person.deltaRespondent ? person.deltaRespondent.getId() ~ ' - ' : '' }}{{ deltakerNavn }}</td>
                    <td>{{ deltakerMobil }}</td>
                    <td>{{ foresattNavn ?: '—' }}</td>
                    <td>{{ foresattMobil ?: '—' }}</td>
                    <td>{{ person.samtykkeSkjema ? person.samtykkeSkjema.getNavn() : '—' }}</td>
                    <td>{{ person.svar ? (harSvar ? 'Ja' : 'Nei') : '—' }}</td>
                    <td>
                        {% if under18 %}
                            {{ harForesattSamtykke is same as(true) ? 'Ja' : (harForesattSamtykke is same as(false) ? 'Nei' : '—') }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if harSvar %}
                            <button type="button" class="btn btn-default" disabled>Send SMS til deltaker</button>
                        {% else %}
                            <button
                                type="button"
                                class="btn btn-primary"
                                onclick="sendPersonvernSMS({{ deltakerMobil|json_encode|raw }}, {{ deltakerNavn|json_encode|raw }}, {{ meldingDeltaker|json_encode|raw }})"
                            >Send SMS til deltaker</button>
                        {% endif %}

                        {% if under18 %}
                            {% if harForesattSamtykke %}
                                <button type="button" class="btn btn-default" disabled>Send SMS til foresatt</button>
                            {% elseif foresattMobil %}
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    onclick="sendPersonvernSMS({{ foresattMobil|json_encode|raw }}, {{ (foresattNavn ?: 'Foresatt')|json_encode|raw }}, {{ meldingForesatt|json_encode|raw }})"
                                >Send SMS til foresatt</button>
                            {% else %}
                                <button type="button" class="btn btn-default" disabled title="Mangler foresatt mobil">Send SMS til foresatt</button>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">Ingen personer i denne gruppen.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% import _self as personvern %}

<div>
    <h1>Under 18 år</h1>
    {{ personvern.personvern_tabell(personerUnder18, true, delta_base_url, personvern_prosjekt_id) }}

    <h1>18 år eller eldre</h1>
    {{ personvern.personvern_tabell(personer18EllerEldre, false, delta_base_url, personvern_prosjekt_id) }}
</div>


<style>
tr.table-personvern.success > td {
    background-color: #a2d8a4 !important;
}
</style>